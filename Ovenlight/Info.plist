<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Ovenlight</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Ovenlight</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.snowyghost.ovenlight</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ovenlight</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSCameraUsageDescription</key>
	<string>Ovenlight uses the camera to scan invite codes, and apps you open can use it when you allow them.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Ovenlight uses Face ID so only you can open your apps.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Ovenlight uses your local network to find a faster, direct path to the computers your apps run on.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Apps you open in Ovenlight can record audio when you ask them to, for example to record a voice note.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Ovenlight saves images you choose from your apps to your photo library.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
