== report
change: Add tagOwners for tag:ovenlight-app-coach, tag:ovenlight-guest-coach, tag:ovenlight-app-notes, tag:ovenlight-guest-notes (owner autogroup:admin).
change: Add one rule to grants: alex@example.com may reach tag:ovenlight-app-coach, tag:ovenlight-app-notes on ports 443 and 8443, as a tagged node is no longer one of your own devices.
change: Add one rule to grants: tag:ovenlight-guest-coach may reach only tag:ovenlight-app-coach:443.
change: Add one rule to grants: tag:ovenlight-guest-notes may reach only tag:ovenlight-app-notes:443.
== diff
--- current policy
+++ proposed policy
@@ -4,10 +4,20 @@
 	},
 	"tagOwners": {
 		"tag:server": ["group:eng"], // build boxes
+		"tag:ovenlight-app-coach": ["autogroup:admin"],
+		"tag:ovenlight-guest-coach": ["autogroup:admin"],
+		"tag:ovenlight-app-notes": ["autogroup:admin"],
+		"tag:ovenlight-guest-notes": ["autogroup:admin"],
 	},
 	"grants": [
 		{"src": ["group:eng"], "dst": ["tag:server"], "ip": ["*"]},
 		{"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]}, // everyone reaches their own devices
 		{"src": ["tag:server"], "dst": ["tag:server"], "ip": ["tcp:5432"]},
+		// Ovenlight: you reach your shared app nodes, and their admin port 8443 (ovenlight setup-sharing).
+		{"src": ["alex@example.com"], "dst": ["tag:ovenlight-app-coach", "tag:ovenlight-app-notes"], "ip": ["tcp:443", "tcp:8443"]},
+		// Ovenlight: guests invited to coach reach only its node, on port 443.
+		{"src": ["tag:ovenlight-guest-coach"], "dst": ["tag:ovenlight-app-coach"], "ip": ["tcp:443"]},
+		// Ovenlight: guests invited to notes reach only its node, on port 443.
+		{"src": ["tag:ovenlight-guest-notes"], "dst": ["tag:ovenlight-app-notes"], "ip": ["tcp:443"]},
 	],
 }
== proposed
{
	"groups": {
		"group:eng": ["alex@example.com"],
	},
	"tagOwners": {
		"tag:server": ["group:eng"], // build boxes
		"tag:ovenlight-app-coach": ["autogroup:admin"],
		"tag:ovenlight-guest-coach": ["autogroup:admin"],
		"tag:ovenlight-app-notes": ["autogroup:admin"],
		"tag:ovenlight-guest-notes": ["autogroup:admin"],
	},
	"grants": [
		{"src": ["group:eng"], "dst": ["tag:server"], "ip": ["*"]},
		{"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]}, // everyone reaches their own devices
		{"src": ["tag:server"], "dst": ["tag:server"], "ip": ["tcp:5432"]},
		// Ovenlight: you reach your shared app nodes, and their admin port 8443 (ovenlight setup-sharing).
		{"src": ["alex@example.com"], "dst": ["tag:ovenlight-app-coach", "tag:ovenlight-app-notes"], "ip": ["tcp:443", "tcp:8443"]},
		// Ovenlight: guests invited to coach reach only its node, on port 443.
		{"src": ["tag:ovenlight-guest-coach"], "dst": ["tag:ovenlight-app-coach"], "ip": ["tcp:443"]},
		// Ovenlight: guests invited to notes reach only its node, on port 443.
		{"src": ["tag:ovenlight-guest-notes"], "dst": ["tag:ovenlight-app-notes"], "ip": ["tcp:443"]},
	],
}
