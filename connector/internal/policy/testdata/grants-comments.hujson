{
	"tagOwners": {
		"tag:ovenlight-app-coach": ["autogroup:admin"],
		"tag:ovenlight-guest-coach": ["autogroup:admin"],
	},
	"acls": [
		{"action": "accept", "src": ["autogroup:member"], "dst": ["autogroup:member:*"]},
	],
	"grants": [
		// TODO: let group:ci reach tag:build once it exists
		// Ovenlight: you reach your shared app nodes, and their admin port 8443 (ovenlight setup-sharing).
		{"src": ["alex@example.com"], "dst": ["tag:ovenlight-app-coach"], "ip": ["tcp:443", "tcp:8443"]},
		// Ovenlight: guests invited to coach reach only its node, on port 443.
		{"src": ["tag:ovenlight-guest-coach"], "dst": ["tag:ovenlight-app-coach"], "ip": ["tcp:443"]},
	],
}
