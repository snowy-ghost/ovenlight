// The ovenlight.app website: static files in site/, served by Cloudflare (Workers static
// assets, the current form of Pages). Deploy as site/README.md says.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ovenlight-site",
  "compatibility_date": "2026-10-01",
  // No request logs: the site promises no tracking.
  "observability": { "enabled": false },
  "assets": { "directory": "site" },
  // Renders docs/ into site/ before each deploy and wrangler dev, and stops on a broken
  // doc link. Needs Go.
  "build": { "command": "go run .", "cwd": "scripts/sitedocs" },
  "routes": [{ "pattern": "ovenlight.app", "custom_domain": true }]
}
