#!/bin/sh
# Starts the Ovenlight connector's MCP server from where install.sh puts the connector. On
# Windows, Claude Code finds mcp.cmd beside this file and runs that instead.
case "$(uname -s)" in
Darwin) bin="$HOME/Library/Application Support/ovenlight/bin/ovenlight" ;;
Linux) bin="${XDG_STATE_HOME:-$HOME/.local/state}/ovenlight/bin/ovenlight" ;;
MINGW* | MSYS* | CYGWIN*) bin="$LOCALAPPDATA/ovenlight/bin/ovenlight.exe" ;;
*)
  echo "The Ovenlight connector doesn't run on $(uname -s)." >&2
  exit 1
  ;;
esac
if [ ! -x "$bin" ]; then
  echo "The Ovenlight connector isn't installed: there's no $bin. Install it with the steps at https://ovenlight.app/support#own-computer, then reconnect the ovenlight server in /mcp." >&2
  exit 1
fi
exec "$bin" mcp "$@"
