<?xml version="1.0" encoding="utf-8"?>
<!-- On Android 10 and 11 allowBackup="false" already stops backups. Lint asks for this file
     beside data_extraction_rules.xml, and it excludes everything too. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
